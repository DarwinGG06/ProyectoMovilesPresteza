{
  "expo": {
    "name": "Presteza",
    "slug": "presteza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fromzero",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#3a0c20"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Presteza usa la cámara para fotografiar el plato de la carta.",
        "NSPhotoLibraryUsageDescription": "Presteza usa la galería para elegir la foto del plato."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "READ_EXTERNAL_STORAGE"],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3a0c20"
      },
      "package": "com.rafamontosteam.presteza"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#3a0c20"
        }
      ],
      "expo-status-bar",
      "expo-router",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Presteza usa la galería para elegir la foto del plato.",
          "cameraPermission": "Presteza usa la cámara para fotografiar el plato de la carta."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ab9035c-11a6-45e5-9fea-3d39e52e077f"
      }
    },
    "owner": "rafamontos-team"
  }
}
